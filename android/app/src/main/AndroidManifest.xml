<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- MCP 服务运行时的常驻状态通知（Android 13+ 需要，运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- MCP 运行状态前台服务（Android 14+ 需要声明服务类型对应的权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- 注意：不要给下面的 <application> 开启 android:enableOnBackInvokedCallback。
         开启后（Android 13+）系统会用预测性返回接管返回键：根 Tab 页无栈可退、
         且没有 PopScope(canPop:false) 时，框架会 setFrameworkHandlesBack(false)
         把返回交给系统直接 finish，Dart 侧的 didPopRoute 不再被调用
         —— 双击退出（global_shortcuts.dart）会被整个跳过，表现为"按一次返回就退出"。 -->
    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- 关闭 Flutter 自带的 deep link 处理（3.27 起默认开启）。
                 它会把 intent 里的**完整 URL** 直接交给 GoRouter：冷启动当
                 initialRoute、热启动走 RouteInformation 运行时推送，两者都会
                 让 GoRouter 拿论坛 URL 去匹配路由表 → "no routes for location"。
                 入站链接统一由 Dart 侧 AppLink + UrlRouter 处理，故在此关闭。 -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 论坛链接的"打开方式"：在浏览器/其他应用点论坛帖子时可选 MTBBS 打开。
                 只登记当前主站（MT 论坛 bbs.binmt.cc）——其它站点尚未适配，用户点开
                 也无法日用，因此不在此声明。
                 不配 autoVerify 是为了始终走"选择打开方式"而不依赖服务器放 assetlinks.json。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:host="bbs.binmt.cc"/>
            </intent-filter>
        </activity>
        <!-- MCP 运行状态前台服务：仅持有常驻通知，端口在 Flutter 侧。
             stopWithTask=true：从最近任务划掉 App 时立即停止服务、撤掉通知。
             前台服务的 stopWithTask 默认为 false，不加这一行则服务会在"退出应用"后
             继续存活，留下假通知（见 docs/07 #65）。 -->
        <service
            android:name=".McpForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="dataSync"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
